{
  "name": "@payops/wdk-solana",
  "version": "0.1.0-beta.1",
  "description": "Reference integration for signing PayOps Solana USDT payments with Tether WDK",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/payops-labs/payops-wdk-solana.git"
  },
  "homepage": "https://github.com/payops-labs/payops-wdk-solana#readme",
  "bugs": {
    "url": "https://github.com/payops-labs/payops-wdk-solana/issues"
  },
  "keywords": [
    "payments",
    "payops",
    "solana",
    "tether",
    "usdt",
    "wdk"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.15.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "example": "tsx examples/pay.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:verify": "pnpm build && npm pack --dry-run --json",
    "release:verify": "pnpm check && pnpm package:verify && pnpm audit --prod",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@payops/core": "0.1.0",
    "@payops/sdk": "0.1.0",
    "@solana-program/token": "0.7.0",
    "@solana/addresses": "3.0.3",
    "@solana/instructions": "3.0.3",
    "@solana/rpc-types": "3.0.3",
    "@solana/transaction-messages": "3.0.3",
    "@tetherto/wdk-wallet-solana": "1.0.0-beta.12"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "prettier": "3.9.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  }
}
